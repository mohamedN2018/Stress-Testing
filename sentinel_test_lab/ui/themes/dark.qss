/* Sentinel Test Lab - dark security-operations theme */
* { font-family: "Segoe UI", "Tahoma"; font-size: 10pt; color: #e6edf3; outline: 0; }
QMainWindow, QDialog, #Root { background: #0f1419; }
QWidget#Page, QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QScrollArea { border: 0; }
QToolTip { background: #1b232d; color: #e6edf3; border: 1px solid #22b8cf; padding: 6px 8px; }

/* ---------- sidebar ---------- */
#Sidebar { background: #121821; border-left: 1px solid #1f2933; }
#Brand { font-size: 14pt; font-weight: 600; color: #e6edf3; }
#BrandSub { color: #6b7a8c; font-size: 8.5pt; }
QPushButton#Nav { text-align: right; padding: 10px 16px; border: 0; border-radius: 8px;
                  background: transparent; color: #9aa7b6; font-size: 10.5pt; }
QPushButton#Nav:hover { background: #18212b; color: #e6edf3; }
QPushButton#Nav:checked { background: #16303a; color: #5fd4e6; font-weight: 600; }
#SafetyPill { background: #132a1c; color: #4ade80; border: 1px solid #1f4d32; border-radius: 8px; padding: 8px 10px; font-size: 9pt; }
#SafetyPill[elevated="true"] { background: #2f2410; color: #fbbf24; border-color: #5a4313; }

/* ---------- top bar ---------- */
#TopBar { background: #0f1419; border-bottom: 1px solid #1f2933; }
#PageTitle { font-size: 15pt; font-weight: 600; }
#PageSubtitle { color: #8b98a8; }
#RunningPill { background: #10283a; color: #7dd3fc; border: 1px solid #1d4a66; border-radius: 12px; padding: 4px 12px; }

/* ---------- cards ---------- */
QFrame#Card { background: #161c24; border: 1px solid #222c38; border-radius: 10px; }
QLabel#CardTitle { font-size: 11pt; font-weight: 600; color: #e6edf3; }
QLabel#Muted, QLabel#Hint { color: #8b98a8; font-size: 9pt; }
QLabel#FieldLabel { color: #b6c2cf; }
QFrame#Stat { background: #161c24; border: 1px solid #222c38; border-radius: 10px; }
QLabel#StatTitle { color: #8b98a8; font-size: 8.5pt; }
QLabel#StatValue { font-size: 15pt; font-weight: 600; color: #e6edf3; }
QLabel#StatValue[tone="good"] { color: #4ade80; }
QLabel#StatValue[tone="bad"] { color: #f87171; }
QLabel#StatValue[tone="warn"] { color: #fbbf24; }
QLabel#StatValue[tone="na"] { color: #5b6878; font-size: 11pt; font-weight: 400; }
QLabel#Banner { border-radius: 8px; padding: 9px 12px; background: #16212c; border: 1px solid #263241; color: #b6c2cf; }
QLabel#Banner[tone="error"] { background: #2a1517; border-color: #5c2327; color: #fca5a5; }
QLabel#Banner[tone="ok"] { background: #132a1c; border-color: #1f4d32; color: #86efac; }
QLabel#Banner[tone="warn"] { background: #2f2410; border-color: #5a4313; color: #fcd34d; }
QLabel#Banner[tone="info"] { background: #10283a; border-color: #1d4a66; color: #7dd3fc; }
QLabel#Badge { border-radius: 9px; padding: 2px 10px; font-size: 8.5pt; font-weight: 600; background: #263241; color: #cbd5e1; }
QLabel#Badge[tone="good"] { background: #14532d; color: #bbf7d0; }
QLabel#Badge[tone="warn"] { background: #5a4313; color: #fde68a; }
QLabel#Badge[tone="bad"] { background: #5c2327; color: #fecaca; }
QLabel#Badge[tone="info"] { background: #1d4a66; color: #bae6fd; }

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background: #0f1419; border: 1px solid #2a3644; border-radius: 6px; padding: 6px 8px;
    selection-background-color: #1d6f80; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #22b8cf; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled, QPlainTextEdit:disabled { color: #5b6878; background: #131920; }
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox QAbstractItemView { background: #161c24; border: 1px solid #2a3644; selection-background-color: #16303a; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; border: 0; background: #1b232d; }
QCheckBox { spacing: 8px; color: #cbd5e1; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #3a4858; border-radius: 4px; background: #0f1419; }
QCheckBox::indicator:checked { background: #22b8cf; border-color: #22b8cf; }
QCheckBox:disabled { color: #5b6878; }

/* ---------- buttons ---------- */
QPushButton { background: #1b232d; border: 1px solid #2a3644; border-radius: 6px; padding: 7px 14px; color: #e6edf3; }
QPushButton:hover { background: #222c38; border-color: #3a4858; }
QPushButton:pressed { background: #18212b; }
QPushButton:disabled { color: #5b6878; background: #141a21; border-color: #1f2933; }
QPushButton#Primary { background: #0e7490; border-color: #1593b3; font-weight: 600; padding: 9px 18px; }
QPushButton#Primary:hover { background: #1188a8; }
QPushButton#Primary:disabled { background: #17303a; border-color: #1c3a45; color: #5b7884; }
QPushButton#Danger { background: #b91c1c; border-color: #dc2626; font-weight: 700; padding: 9px 18px; color: #ffffff; }
QPushButton#Danger:hover { background: #dc2626; }
QPushButton#Danger:disabled { background: #2a1517; border-color: #3f1d20; color: #7a4b4f; }
QPushButton#Link { background: transparent; border: 0; color: #5fd4e6; padding: 2px 4px; }
QPushButton#Link:hover { color: #a5ecf7; }

/* ---------- tables / tabs ---------- */
QTableWidget, QTableView, QTextBrowser, QListWidget { background: #131920; border: 1px solid #222c38; border-radius: 8px;
    gridline-color: #1f2933; alternate-background-color: #161c24; }
QTableWidget::item, QTableView::item { padding: 5px 8px; border: 0; }
QTableWidget::item:selected, QTableView::item:selected, QListWidget::item:selected { background: #16303a; color: #e6edf3; }
QHeaderView::section { background: #18212b; color: #8b98a8; border: 0; border-bottom: 1px solid #263241; padding: 7px 8px; font-size: 9pt; }
QTableCornerButton::section { background: #18212b; border: 0; }
QTabWidget::pane { border: 0; top: -1px; }
QTabBar::tab { background: transparent; color: #8b98a8; padding: 9px 18px; border-bottom: 2px solid transparent; font-size: 10.5pt; }
QTabBar::tab:hover { color: #e6edf3; }
QTabBar::tab:selected { color: #5fd4e6; border-bottom: 2px solid #22b8cf; font-weight: 600; }
QProgressBar { background: #131920; border: 1px solid #222c38; border-radius: 5px; height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #22b8cf; border-radius: 4px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2a3644; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3a4858; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2a3644; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: transparent; }
QMessageBox, QInputDialog { background: #161c24; }
QPlainTextEdit#Log { background: #0c1116; border: 1px solid #1f2933; color: #9aa7b6; font-family: "Consolas"; font-size: 9pt; }
